# ---------------------------------------------------------------------------
# Vrindavan production config. Copy this file to `.env` (same folder) and fill
# it in. NEVER commit the real .env — it holds secrets.
#
#   cp .env.prod.example .env && nano .env
# ---------------------------------------------------------------------------

# --- Your domain / TLS ------------------------------------------------------
# The public address Caddy serves. Use your real domain to get automatic HTTPS.
# For a first smoke test before DNS is pointed, set this to ":80" (plain HTTP).
SITE_ADDRESS=app.yourdomain.com

# The public API origin baked into the Flutter web build. Almost always your
# domain + "/api" (Caddy serves the app and proxies /api on the same origin).
# IMPORTANT: this is compile-time. If you change it, rebuild the `web` image.
API_BASE_URL=https://app.yourdomain.com/api

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=vrindavan
# Use a long random password. Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=vrindavan

# Must match the three values above. Host is the compose service name `db`.
DATABASE_URL=postgres://vrindavan:CHANGE_ME_db_password@db:5432/vrindavan

# --- JWT secrets (min 16 chars each; use different values) ------------------
# Generate each: openssl rand -hex 32
ACCESS_TOKEN_SECRET=CHANGE_ME_access_secret_at_least_16_chars
REFRESH_TOKEN_SECRET=CHANGE_ME_refresh_secret_at_least_16_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_SECONDS=2592000

LOG_LEVEL=info

# --- Email (OTP + notifications) --------------------------------------------
# `console` prints OTPs/emails to the backend logs — fine to launch with, but
# users won't receive real emails. Switch to `smtp` and fill the block below
# when you want real delivery (e.g. a transactional provider or your mailbox).
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@yourdomain.com
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASSWORD=your_smtp_password
# SMTP_SECURE=false
