# Caddy config for Vrindavan — single domain / IP / smoke test (the SAFE default).
#
# SITE_ADDRESS controls the site + TLS behaviour:
#   - a real domain (app.yourdomain.com) -> Caddy auto-provisions a Let's Encrypt HTTPS cert
#   - ":80"                              -> plain HTTP (current IP deploy, e.g. http://50.6.44.23)
#
# For the MULTI-TENANT SUBDOMAIN model (*.enrix.in) use deploy/Caddyfile.subdomains instead —
# it adds on-demand TLS, which REQUIRES real hostnames and must NOT be used on :80 / a bare IP.
#
# All backend traffic (the NestJS `/api` prefix, the excluded `/health`, and the `/uploads`
# static mount) is proxied to the backend; everything else is the Flutter SPA (index.html
# fallback for client-side routing).

{$SITE_ADDRESS} {
	encode gzip zstd

	@backend path /api/* /uploads/* /health
	handle @backend {
		reverse_proxy backend:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
