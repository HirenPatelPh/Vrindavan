# Caddy config for the MULTI-TENANT SUBDOMAIN model (vrindavan.enrix.in, mahindra.enrix.in, ...).
#
# Use this ONLY once a wildcard DNS record `*.enrix.in` points at the server. It issues a TLS cert
# per hostname ON DEMAND, gated by the backend so certs are only minted for real, active tenants.
# Do NOT use on :80 / a bare IP — on-demand TLS needs real hostnames.
#
# To activate on the server:
#   cp deploy/Caddyfile.subdomains deploy/Caddyfile     (or mount this file as /etc/caddy/Caddyfile)
#   set in .env:  SITE_ADDRESS=*.enrix.in, enrix.in   BASE_DOMAIN=enrix.in   API_BASE_URL=
#   docker compose up -d --build web

{
	# Before issuing a cert for an incoming hostname, Caddy asks the backend whether that host maps
	# to an active tenant. Only a 2xx allows issuance — this is what makes `*.enrix.in` safe.
	on_demand_tls {
		ask http://backend:3000/api/tls-check
	}
}

{$SITE_ADDRESS} {
	tls {
		on_demand
	}

	encode gzip zstd

	@backend path /api/* /uploads/* /health
	handle @backend {
		reverse_proxy backend:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
